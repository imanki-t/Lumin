# ==============================================================================
# LUMIN CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# AI & LLM Engine Keys (Comma-separated for auto-rotation)
GEMINI_API_KEYS=key1,key2,key3
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
FALLBACK_GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
LOCAL_GEMMA_ENDPOINT=http://localhost:11434

# Redis Cache & Sliding Window
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=lumin:

# Database
MONGODB_URI=mongodb://localhost:27017/lumin
DATABASE_URL=postgres://lumin:secret@localhost:5432/lumin

# Web & Dashboard Server
PORT=3000
NODE_ENV=production
DASHBOARD_AUTH_SECRET=generate_a_random_32_byte_secret_here
DASHBOARD_ADMIN_IDS=123456789012345678,234567890123456789

# External APIs
TENOR_API_KEY=
GIPHY_API_KEY=

# Alerting & Monitoring
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
