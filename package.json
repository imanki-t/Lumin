{
  "name": "lumin",
  "version": "4.0.0",
  "description": "Lumin — Enterprise-Grade Discord Bot powered by Gemini 3.5 & Gemma",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node --max-old-space-size=1024 dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "discord",
    "discord-bot",
    "gemini",
    "gemma",
    "ai",
    "multimodal",
    "typescript",
    "rag",
    "redis"
  ],
  "author": "unmuted",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@redis/client": "^1.6.0",
    "axios": "^1.16.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.475.0",
    "mongodb": "^6.16.0",
    "next": "^15.1.7",
    "node-cron": "^4.2.1",
    "node-os-utils": "^1.3.7",
    "office-text-extractor": "^4.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.2",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/node-os-utils": "^1.3.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
